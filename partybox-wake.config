# This template is copied to build/ on the first build.
# --save-name sets the default by name alone. --save sets it by UUID.
# Successful wake requests update the last speaker.
default_uuid=
default_name=
# Set to true to save a replacement default UUID after an unambiguous name or paired-address match.
autoupdate_uuid=false
last_wake_uuid=
last_wake_name=
